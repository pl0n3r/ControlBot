Options -Indexes
DirectoryIndex index.php

# Owner-only access gate. Credentials stay outside the repository.
# If any authentication module is unavailable, PHP still fails closed because REMOTE_USER is absent.
<IfModule mod_auth_basic.c>
<IfModule mod_authn_file.c>
<IfModule mod_authz_core.c>
AuthType Basic
AuthName "ControlBot"
AuthUserFile /home/u151692719/.htpasswds/controlbot
Require valid-user
</IfModule>
</IfModule>
</IfModule>

# Public login identifier and non-secret snapshot location only; password/hash remain server-side.
# If mod_env is unavailable, the application fails closed because owner_login is missing.
<IfModule mod_env.c>
SetEnv CONTROLBOT_OWNER_LOGIN USUARIO
SetEnv CONTROLBOT_ORCHESTRATOR_SNAPSHOT_PATH /home/u151692719/domains/control.condorapp.com.co/private/orchestrator-live.json
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On

# Internal repository surfaces are never public.
RewriteRule ^(?:src|config|docs|scripts|tests|vendor|lecciones|openapi|readme)(?:/|$) - [F,L,NC]
RewriteRule ^(?:\.git|\.github)(?:/|$) - [F,L,NC]
RewriteRule ^(?:AGENTES|AGENTS|README|CHANGELOG|LICENSE)(?:\.[^/]+)?$ - [F,L,NC]
RewriteRule \.(?:md|ya?ml|json|lock|sql|log|ini|dist|xml|toml)$ - [F,L,NC]
RewriteRule ^(?!(?:index\.php|public/index\.php)$).+\.php$ - [F,L,NC]

# Only the intended public surface bypasses the front controller.
RewriteRule ^(?:index\.php$|public(?:/|$)) - [L,NC]
RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_authz_core.c>
<FilesMatch "(?i)^(?:\.|AGENTES|AGENTS|README|CHANGELOG)|\.(?:md|ya?ml|json|lock|sql|log|ini|dist|xml|toml)$">
    Require all denied
</FilesMatch>
</IfModule>
