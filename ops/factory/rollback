#!/usr/bin/env python3
"""Offline-only synthetic rollback preflight. Never changes files or deploys."""
from __future__ import annotations

import json
import re
import sys

MAX_INPUT_BYTES = 8192
SHA = re.compile(r"[0-9a-f]{40}\Z")
FIELDS = frozenset({
    "kind", "phase", "plan_kind", "candidate_sha", "previous_healthy_sha",
    "expected_healthy_sha", "baseline_verified", "previous_artifact_verified",
    "rollback_plan_verified",
})


def _unique_pairs(pairs: list[tuple[str, object]]) -> dict[str, object]:
    result: dict[str, object] = {}
    for name, value in pairs:
        if name in result:
            raise ValueError("duplicate field")
        result[name] = value
    return result


def _invalid_constant(value: str) -> object:
    raise ValueError("invalid numeric constant")


def _reason(payload: object) -> str:
    if not isinstance(payload, dict) or set(payload) != FIELDS:
        return "invalid_synthetic_fixture"
    if payload["kind"] != "synthetic" or payload["plan_kind"] != "git_revert":
        return "invalid_synthetic_fixture"
    if payload["phase"] != "construccion":
        return "invalid_synthetic_fixture"
    for key in ("candidate_sha", "previous_healthy_sha", "expected_healthy_sha"):
        if not isinstance(payload[key], str) or not SHA.fullmatch(payload[key]):
            return "invalid_synthetic_fixture"
    for key in ("baseline_verified", "previous_artifact_verified", "rollback_plan_verified"):
        if type(payload[key]) is not bool:
            return "invalid_synthetic_fixture"
    if not payload["baseline_verified"]:
        return "baseline_unverified"
    if not payload["previous_artifact_verified"]:
        return "previous_artifact_unverified"
    if payload["previous_healthy_sha"] != payload["expected_healthy_sha"]:
        return "healthy_sha_mismatch"
    if payload["candidate_sha"] == payload["previous_healthy_sha"]:
        return "no_prior_release"
    if not payload["rollback_plan_verified"]:
        return "rollback_plan_unverified"
    return "synthetic_checks_passed"


def _emit(reason: str) -> None:
    print(json.dumps({
        "mode": "offline_preflight",
        "status": "SYNTHETIC_ONLY" if reason == "synthetic_checks_passed" else "REJECTED",
        "reason": reason,
        "rollback_executed": False,
        "production_ready": False,
        "readiness": "UNKNOWN",
    }, sort_keys=True, separators=(",", ":")))


def main(args: list[str]) -> int:
    if args != ["--offline-dry-run"]:
        _emit("mode_not_authorized")
        return 2
    try:
        raw = sys.stdin.buffer.read(MAX_INPUT_BYTES + 1)
        if not raw or len(raw) > MAX_INPUT_BYTES:
            _emit("invalid_synthetic_fixture")
            return 2
        payload = json.loads(
            raw.decode("utf-8"),
            object_pairs_hook=_unique_pairs,
            parse_constant=_invalid_constant,
        )
        reason = _reason(payload)
    except (ValueError, UnicodeError, TypeError, RecursionError):
        reason = "invalid_synthetic_fixture"
    _emit(reason)
    return 0 if reason == "synthetic_checks_passed" else 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
