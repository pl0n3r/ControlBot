Options -Indexes
DirectoryIndex index.php

# Owner-only access gate. Credentials stay outside the repository.
# If any authentication module is unavailable, PHP still fails closed because REMOTE_USER is absent.
<IfModule mod_auth_basic.c>
<IfModule mod_authn_file.c>
<IfModule mod_authz_core.c>
# La ventana de usuario y contraseña solo se retira cuando el dueño crea el archivo marcador
# (junto con CONTROLBOT_OWNER_PASSWORD_HASH en el servidor). Sin él, sigue cerrado como antes.
<If "! -f '/home/u151692719/.htpasswds/owner-login-enabled'">
AuthType Basic
AuthName "ControlBot"
AuthUserFile /home/u151692719/.htpasswds/controlbot
Require valid-user
</If>
</IfModule>
</IfModule>
</IfModule>

# Public login identifier and non-secret snapshot location only; password/hash remain server-side.
# If mod_env is unavailable, the application fails closed because owner_login is missing.
<IfModule mod_env.c>
SetEnv CONTROLBOT_OWNER_LOGIN USUARIO
# Secrets live in private files outside the repo (plans without environment variables); only the paths are here.
SetEnv CONTROLBOT_VAULT_KEY_FILE /home/u151692719/domains/control.condorapp.com.co/private/vault.key
SetEnv CONTROLBOT_OWNER_PASSWORD_HASH_FILE /home/u151692719/domains/control.condorapp.com.co/private/owner-password.hash
SetEnv CONTROLBOT_ORCHESTRATOR_SNAPSHOT_PATH /home/u151692719/domains/control.condorapp.com.co/private/orchestrator-live.json
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On

# Internal repository surfaces are never public.
RewriteRule ^(?:src|config|docs|scripts|tests|vendor|lecciones|openapi|readme)(?:/|$) - [F,L,NC]
RewriteRule ^(?:\.git|\.github)(?:/|$) - [F,L,NC]
RewriteRule ^(?:AGENTES|AGENTS|README|CHANGELOG|LICENSE)(?:\.[^/]+)?$ - [F,L,NC]
RewriteRule \.(?:md|ya?ml|json|lock|sql|log|ini|dist|xml|toml)$ - [F,L,NC]
# Reject direct client access to the internal health entrypoint. Internal rewrites keep the original THE_REQUEST.
RewriteCond %{THE_REQUEST} \s/+public/health\.php(?:\s|\?|$) [NC]
RewriteRule ^public/health\.php$ - [R=404,L,NC]
# La página de login se sirve solo como /login; el archivo no es accesible directamente.
RewriteCond %{THE_REQUEST} \s/+public/login\.php(?:\s|\?|$) [NC]
RewriteRule ^public/login\.php$ - [R=404,L,NC]
RewriteRule ^(?!(?:index\.php|public/index\.php|health\.php|public/health\.php|public/login\.php)$).+\.php$ - [F,L,NC]

# Owner-gated health route stays closed without real server auth and private artifact.
RewriteRule ^health\.php$ public/health.php [L,NC]
RewriteRule ^login$ public/login.php [L,NC]
# Only the intended public surface bypasses the front controller.
RewriteRule ^(?:index\.php$|public(?:/|$)) - [L,NC]
RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_authz_core.c>
<FilesMatch "(?i)^(?:\.|AGENTES|AGENTS|README|CHANGELOG)|\.(?:md|ya?ml|json|lock|sql|log|ini|dist|xml|toml)$">
    Require all denied
</FilesMatch>
</IfModule>
